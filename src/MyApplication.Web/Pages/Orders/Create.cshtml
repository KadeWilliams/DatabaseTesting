@page
@model MyApplication.Web.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "New Order";
}

<h1>New Order</h1>

<form method="post" class="card" style="max-width: 640px;">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <div class="field">
        <label asp-for="Order.CustomerId">Customer</label>
        <select asp-for="Order.CustomerId" asp-items="Model.CustomerOptions">
            <option value="">-- select a customer --</option>
        </select>
        <span asp-validation-for="Order.CustomerId" class="text-danger"></span>
    </div>

    <div class="field">
        <label asp-for="Order.StatusId">Status</label>
        <select asp-for="Order.StatusId" asp-items="Model.StatusOptions"></select>
    </div>

    <div class="field">
        <label asp-for="Order.Notes">Notes</label>
        <textarea asp-for="Order.Notes" rows="2"></textarea>
    </div>

    <h3>Line Items</h3>
    <div class="line-items">
        @for (var i = 0; i < Model.Order.LineItems.Count; i++)
        {
            <div class="line-item-row">
                <div class="field">
                    <label>Product</label>
                    <input asp-for="Order.LineItems[i].ProductName" />
                </div>
                <div class="field">
                    <label>Qty</label>
                    <input asp-for="Order.LineItems[i].Quantity" type="number" min="0" />
                </div>
                <div class="field">
                    <label>Unit Price</label>
                    <input asp-for="Order.LineItems[i].UnitPrice" type="number" min="0" step="0.01" />
                </div>
            </div>
        }
    </div>
    <p class="muted">Leave a row's product name blank to skip it.</p>

    <button type="submit" class="btn">Create Order</button>
    <a class="btn btn-secondary" href="/Orders">Cancel</a>
</form>
