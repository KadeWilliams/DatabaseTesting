@page "{id:int}"
@model MyApplication.Web.Pages.Customers.EditModel
@{
    ViewData["Title"] = "Edit Customer";
}

<h1>Edit Customer</h1>

<form method="post" class="card">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <input type="hidden" asp-for="Customer.CustomerId" />

    <div class="field">
        <label asp-for="Customer.FirstName">First Name</label>
        <input asp-for="Customer.FirstName" />
        <span asp-validation-for="Customer.FirstName" class="text-danger"></span>
    </div>

    <div class="field">
        <label asp-for="Customer.LastName">Last Name</label>
        <input asp-for="Customer.LastName" />
        <span asp-validation-for="Customer.LastName" class="text-danger"></span>
    </div>

    <div class="field">
        <label asp-for="Customer.Email">Email</label>
        <input asp-for="Customer.Email" type="email" />
        <span asp-validation-for="Customer.Email" class="text-danger"></span>
    </div>

    <button type="submit" class="btn">Save</button>
    <a class="btn btn-secondary" href="/Customers">Cancel</a>
</form>
